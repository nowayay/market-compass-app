OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# KRS provider request timeout (ms)
KRS_API_TIMEOUT_MS=8000

# Company identification by name (paid OpenAI web search).
# Disabled unless explicitly set to "true".
COMPANY_IDENTIFICATION_ENABLED=false
COMPANY_IDENTIFICATION_TIMEOUT_MS=30000
# Process-local safeguards (not a distributed rate limiter):
COMPANY_IDENTIFICATION_WINDOW_MS=600000
COMPANY_IDENTIFICATION_MAX_PER_WINDOW=10
COMPANY_IDENTIFICATION_MAX_CONCURRENT=2

# Official domain discovery (paid OpenAI web search, separate from identification).
# Disabled unless explicitly set to "true"; all values have defaults, so no new
# variable is required while the feature is off.
COMPANY_DOMAIN_DISCOVERY_ENABLED=false
COMPANY_DOMAIN_DISCOVERY_TIMEOUT_MS=15000
COMPANY_DOMAIN_DISCOVERY_MAX_TOOL_CALLS=2
COMPANY_DOMAIN_DISCOVERY_MAX_OUTPUT_TOKENS=1200
# Process-local safeguards (not a distributed rate limiter):
COMPANY_DOMAIN_DISCOVERY_MAX_REQUESTS_PER_WINDOW=10
COMPANY_DOMAIN_DISCOVERY_WINDOW_MS=600000
COMPANY_DOMAIN_DISCOVERY_MAX_CONCURRENT=1
